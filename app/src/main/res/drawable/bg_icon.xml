<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Purple gradient like Figma -->
    <gradient
        android:type="linear"
        android:angle="90"
        android:startColor="#9B7E9E"
        android:endColor="#7A5D7D"/>

    <!-- Rounded corners -->
    <corners android:radius="20dp"/>

    <!-- Optional elevation shadow support -->
    <padding
        android:left="0dp"
        android:top="0dp"
        android:right="0dp"
        android:bottom="0dp"/>

</shape>
