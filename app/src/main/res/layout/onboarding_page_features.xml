<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient">

    <!-- Top icon -->
    <ImageView
        android:layout_width="130dp"
        android:layout_height="130dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="100dp"
        android:padding="32dp"
        android:background="@drawable/bg_icon"
        android:src="@drawable/ic_shield_outline"/>

    <!-- White card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="24dp"
        android:background="@drawable/bg_card"
        android:elevation="2dp"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Feature 1 -->
        <TextView
            style="@style/TextHeading"
            android:text="Upload  Manage"
            android:layout_marginBottom="6dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            style="@style/TextBody"
            android:text="Store all your certificates securely in one place with easy organization"
            android:layout_marginBottom="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <!-- Feature 2 -->
        <TextView
            style="@style/TextHeading"
            android:text="Real-Time Verification"
            android:layout_marginBottom="6dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            style="@style/TextBody"
            android:text="Track the status of your credentials as they move through the verification process"
            android:layout_marginBottom="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <!-- Feature 3 -->
        <TextView
            style="@style/TextHeading"
            android:text="Instant Access"
            android:layout_marginBottom="6dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            style="@style/TextBody"
            android:text="Employers can view and verify credentials instantly without delays"
            android:layout_marginBottom="24dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <!-- Page indicator -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp">

            <View
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@drawable/bg_dot_inactive"/>

            <View
                android:layout_width="20dp"
                android:layout_height="6dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_icon"/>
        </LinearLayout>

        <!-- Next button -->
        <Button
            android:id="@+id/btnNext"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_button_primary"
            android:text="@string/next"
            android:textColor="#FFFFFF"
            android:stateListAnimator="@null"
            android:textAllCaps="false"/>

    </LinearLayout>

</FrameLayout>
